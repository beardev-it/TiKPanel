# Copia questo file in .env e compila i valori.

# --- Connessione al router MikroTik (REST API RouterOS, richiede RouterOS >= 7.1) ---
MIKROTIK_HOST=192.168.88.1
MIKROTIK_PORT=443
MIKROTIK_USER=api-user
MIKROTIK_PASSWORD=cambia-questa-password
MIKROTIK_USE_SSL=true
# Metti a true in produzione se il router ha un certificato valido/riconosciuto
MIKROTIK_VERIFY_SSL=false
MIKROTIK_TIMEOUT=10

# --- Sicurezza di questo servizio ---
# X-API-Key: per uso programmatico (script, curl, integrazioni)
API_KEY=genera-una-chiave-lunga-e-casuale
# SECRET_KEY: firma i token di sessione (JWT) rilasciati dal login della dashboard web.
# Generane una diversa da API_KEY, lunga e casuale (es. openssl rand -hex 32).
SECRET_KEY=genera-un-altra-chiave-lunga-e-casuale
# Durata della sessione dopo il login (minuti). Default 8 ore.
SESSION_EXPIRE_MINUTES=480

# --- Dashboard web (/ui) ---
# URL base che il frontend deve usare per parlare con questo servizio.
# Lascia vuoto se la dashboard è servita dallo stesso container (caso normale).
# Valorizzalo solo se ospiti static/ su un host diverso dal backend.
PUBLIC_BASE_URL=

# --- Blocco client ---
BLOCK_ADDRESS_LIST=supervisortik-blocked
AUTO_CREATE_FIREWALL_RULE=true

LOG_LEVEL=INFO
