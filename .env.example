# Copia questo file in .env e compila i valori.

# --- Connessione al router MikroTik (REST API RouterOS, richiede RouterOS >= 7.1) ---
MIKROTIK_HOST=192.168.88.1
MIKROTIK_PORT=443
MIKROTIK_USER=api-user
MIKROTIK_PASSWORD=cambia-questa-password
MIKROTIK_USE_SSL=true
# Metti a true in produzione se il router ha un certificato valido/riconosciuto
MIKROTIK_VERIFY_SSL=false
MIKROTIK_TIMEOUT=10

# --- Sicurezza di questo servizio (richiesta nell'header X-API-Key) ---
API_KEY=genera-una-chiave-lunga-e-casuale

# --- Blocco client ---
BLOCK_ADDRESS_LIST=supervisortik-blocked
AUTO_CREATE_FIREWALL_RULE=true

LOG_LEVEL=INFO
